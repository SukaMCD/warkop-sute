{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warkop-sudut-temu",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sute",
      "database_id": "26a26f63-216a-4bb5-94d0-1797fd882524"
    }
  ]
}
