# ========================================================
# Warkop Sudut Temu (SUTE) - Environment Configuration
# ========================================================

# --- Frontend (Vite) Configuration ---
# URL endpoint backend API (Gunakan relative '/api' jika reverse proxy / single domain, atau http://localhost:8787/api saat dev terpisah)
VITE_API_URL=http://localhost:8787/api

# Identitas Usaha & Struk Kasir
VITE_STORE_NAME="Warkop Sudut Temu"
VITE_STORE_TAGLINE="Sudut Temu, Cerita Mengalir"
VITE_STORE_ADDRESS="Jl. Warkop Sudut Temu, Indonesia"
VITE_STORE_PHONE="0812-3456-7890"
VITE_RECEIPT_FOOTER="Terima kasih atas kunjungannya! Datang lagi ya lur."

# QRIS Pembayaran Statis (NMID Resmi Warkop Sudut Temu)
VITE_QRIS_NMID="ID1026568944999"
VITE_QRIS_IMAGE_URL="/qris-sute.png"

# --- Backend (Cloudflare Workers & Hono) Configuration ---
# Mode environment: development | production
ENVIRONMENT=development

# Secret key untuk otentikasi / session (ganti dengan string acak aman di production)
JWT_SECRET=rahasia-warkop-sudut-temu-super-secret-2026

# Cloudflare D1 Database ID (Diisi saat deploy ke cloudflare via secret/wrangler)
# D1_DATABASE_ID=local-warkop-db
